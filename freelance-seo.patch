+<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Service page layout checks</title><style>body{font:14px system-ui;background:#181818;color:white;margin:16px}button,select{padding:10px;margin:4px}iframe{display:block;border:1px solid #666;max-width:none;background:#0b0b0c}#stage{overflow:auto;max-width:100%}pre{white-space:pre-wrap;max-height:120px;overflow:auto}</style></head><body>
+<h1>Production SEO checks</h1><p>Chromium iframe viewports. No Safari or device-GPU emulation.</p>
+<button id="run">Run service checks</button><button id="mobile">Show mobile home</button><button id="tablet">Show tablet services</button><button id="desktop">Show desktop home</button><button id="contact">Show mobile contact</button><pre id="results">Ready</pre><div id="stage"></div>
+<script type="module">
+const stage=document.querySelector('#stage'),results=document.querySelector('#results');
+let frame;const sleep=ms=>new Promise(r=>setTimeout(r,ms));
+async function load(path,w,h){if(frame)frame.remove();frame=document.createElement('iframe');frame.width=w;frame.height=h;frame.title='Site under test';stage.append(frame);await new Promise((resolve,reject)=>{frame.onload=resolve;frame.onerror=reject;frame.src=path;});await frame.contentDocument.fonts.ready;await sleep(200);return frame.contentDocument;}
+const assert=(ok,message)=>{results.textContent+='\n'+(ok?'PASS ':'FAIL ')+message;if(!ok)throw Error(message)};
+document.querySelector('#run').onclick=async()=>{results.textContent='Running';try{
+for(const [name,w,h] of [['small phone',320,780],['phone',390,844],['tablet',820,1180],['desktop',1348,900]]){
+for(const path of ['/','/services/','/services/business-websites/','/services/ecommerce-development/','/services/landing-pages/','/services/website-redesign/','/projects/gymdrobe/','/contact/','/privacy/']){
+const doc=await load(path,w,h);
+assert(doc.querySelectorAll('h1').length===1,name+' '+path+': one clear H1');
+assert(doc.documentElement.scrollWidth<=w,name+' '+path+': no horizontal overflow');
+assert([...doc.querySelectorAll('header a')].every(a=>{const r=a.getBoundingClientRect();return r.left>=0&&r.right<=w}),name+' '+path+': header navigation fits');
+assert(!!doc.querySelector('a[href^="https://wa.me/918156805806"]'),name+' '+path+': WhatsApp action available');
+if(path==='/'){const c=doc.querySelector('.hero-copy .button-solid').getBoundingClientRect();assert(c.bottom<h-60,name+': discuss website visible in first screen');assert(doc.querySelector('.portfolio').dataset.sceneStatus!=='user-static',name+': automatic 3D not disabled by marketing changes');}
+else assert(!doc.querySelector('canvas'),name+' '+path+': service content independent of 3D');
+}
+}
+const doc=await load('/contact/',390,844);const f=doc.querySelector('form');
+f.querySelector('button[type="submit"]').click();await sleep(50);
+assert(doc.querySelectorAll('[aria-invalid="true"]').length>=3,'empty form gives associated field errors');
+assert(doc.activeElement?.name==='name','first invalid field receives focus');
+const fill=(name,value)=>{const input=f.elements.namedItem(name);input.value=value;input.dispatchEvent(new Event('input',{bubbles:true}));input.dispatchEvent(new Event('change',{bubbles:true}));};
+fill('name','QA Example');fill('phone','+91 9999999999');fill('service','Business websites');fill('message','I need a responsive site to explain my business services.');
+f.querySelector('button[type="submit"]').click();await sleep(50);
+assert(doc.querySelectorAll('[aria-invalid="true"]').length===0,'phone-only enquiry is valid');
+assert(f.textContent.includes('Nothing has been sent'),'WhatsApp handoff never claims delivery');
+const link=f.querySelector('a[href^="https://wa.me/"]');assert(!!link,'review-and-send WhatsApp link prepared without submitting externally');
+assert(new URL(link.href).searchParams.get('text').includes('QA Example'),'prepared message includes the brief');
+for(const path of ['/services/','/contact/','/projects/gymdrobe/']){const response=await fetch(path);assert(response.status===200,path+': production HTTP 200');const html=await response.text();assert(html.includes('rel="canonical"'),'canonical is in HTTP HTML before JS');}
+assert((await fetch('/__forge-missing-page-check-2026/')).status===404,'unknown route has genuine HTTP 404');
+assert((await fetch('/assets/nonexistent.js')).status===404,'missing asset has HTTP 404');
+const clean=await fetch('/services',{redirect:'follow'});assert(clean.status===200,'clean URL without trailing slash resolves');
+assert((await (await fetch('/services/?utm_source=qa')).text()).includes('href="https://fazhere.com/services/"'),'tracking parameters do not change canonical');
+assert((await (await fetch('/sitemap.xml')).text()).includes('<loc>https://fazhere.com/services/</loc>'),'sitemap served as generated');
+assert((await (await fetch('/robots.txt')).text()).includes('Sitemap: https://fazhere.com/sitemap.xml'),'robots sitemap declaration served');
+results.textContent+='\nDONE. No external form or WhatsApp message was sent.';
+}catch(e){results.textContent+='\nERROR '+e.message;}};
+document.querySelector('#mobile').onclick=()=>load('/',390,844);
+document.querySelector('#tablet').onclick=()=>load('/services/',820,1180);
+document.querySelector('#desktop').onclick=()=>load('/',1348,900);
+document.querySelector('#contact').onclick=()=>load('/contact/',390,844);
+</script></body></html>
diff --git a/tests/seo.test.mjs b/tests/seo.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0ed4b3a5ad0bf1e54626533125c4184427870280
--- /dev/null
+++ b/tests/seo.test.mjs
@@ -0,0 +1,79 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { pages, pageForPath, structuredData, notFound } from '../src/seo/pages.js';
+import { renderHead, isPreview } from '../scripts/seo.mjs';
+import { readEnquiry, validateEnquiry, formEndpoint, enquiryMessage, submitEnquiry } from '../src/enquiries/form.js';
+import { SITE_ORIGIN, whatsappHref } from '../src/data/site.js';
+import { analyticsAllowed } from '../src/seo/analytics.js';
+
+const valid = { name: 'QA Example', email: 'example@example.com', phone: '', business: '', service: 'Business websites', message: 'A responsive website to explain my services.', budget: '', _gotcha: '' };
+test('marketing routes have unique canonical URLs and unique titles/descriptions', () => {
+  for (const key of ['path', 'title', 'description']) assert.equal(new Set(pages.map(p => p[key])).size, pages.length);
+  assert.equal(pageForPath('/services?utm_source=example').path, '/services/');
+  assert.equal(pageForPath('/services/').path, '/services/');
+  assert.equal(pageForPath('/not-a-real-page').noindex, true);
+  assert.equal(pageForPath('/services//').path, '/services/');
+});
+test('metadata is initial HTML, escapes verification values, and noindexes previews/404s', () => {
+  const page = pages[2];
+  const production = renderHead(page, { GOOGLE_SITE_VERIFICATION: '"><script>unsafe</script>' });
+  assert.ok(production.includes(`href="${SITE_ORIGIN}${page.path}"`));
+  assert.ok(production.includes('index, follow, max-image-preview:large'));
+  assert.ok(production.includes('&lt;script&gt;unsafe&lt;/script&gt;'));
+  for (const env of [{ SITE_ENV: 'preview' }, { IS_PULL_REQUEST: 'true', SITE_ENV: 'production' }]) {
+    assert.equal(isPreview(env), true); assert.ok(renderHead(page, env).includes('noindex, follow'));
+  }
+  assert.ok(renderHead(notFound).includes('noindex, follow'));
+  assert.ok(!renderHead(notFound).includes('rel="canonical"'));
+});
+test('structured data connects the person, site, visible service and breadcrumbs without invented business details', () => {
+  for (const page of pages) {
+    const graph = structuredData(page)['@graph'];
+    assert.equal(graph[0]['@type'], 'Person');
+    assert.equal(graph[0].name, 'Muhammed Favas K');
+    assert.ok(graph[0].sameAs.some(url => url.includes('linkedin.com')));
+    assert.ok(!JSON.stringify(graph).match(/aggregateRating|openingHours|streetAddress|priceCurrency|reviewRating/));
+    if (page.service) {
+      const service = graph.find(n => n['@type'] === 'Service');
+      assert.equal(service.provider['@id'], graph[0]['@id']);
+      assert.equal(service.name, page.service.name);
+      assert.equal(graph.find(n => n['@type'] === 'BreadcrumbList').itemListElement.length, 3);
+    }
+  }
+});
+test('enquiry requires one contact method and validates supplied email and phone', () => {
+  assert.deepEqual(validateEnquiry(valid), {});
+  assert.ok(validateEnquiry({ ...valid, email: '', phone: '' }).email);
+  assert.deepEqual(validateEnquiry({ ...valid, email: '', phone: '+91 8156805806' }), {});
+  assert.ok(validateEnquiry({ ...valid, email: 'broken', phone: '+91 8156805806' }).email);
+  assert.ok(validateEnquiry({ ...valid, phone: '123' }).phone);
+  assert.ok(validateEnquiry({ ...valid, name: ' ', message: 'short', service: '' }).message);
+});
+test('enquiry values are bounded and WhatsApp handoff preserves readable information', () => {
+  const data = readEnquiry(new Map(Object.entries({ ...valid, message: 'x'.repeat(4000), irrelevant: 'ignored' })));
+  assert.equal(data.message.length, 3000); assert.equal(data.irrelevant, undefined);
+  const url = new URL(whatsappHref(enquiryMessage(valid)));
+  assert.equal(url.pathname, '/918156805806'); assert.ok(url.searchParams.get('text').includes(valid.message));
+});
+test('form endpoint accepts public Formspree IDs only and never needs a browser secret', () => {
+  assert.equal(formEndpoint('https://bad.example'), ''); assert.equal(formEndpoint(''), '');
+  assert.equal(formEndpoint('exampleid'), 'https://formspree.io/f/exampleid');
+});
+test('analytics require a configured ID and an indexable page; preview and 404 documents cannot enable tracking', () => {
+  assert.equal(analyticsAllowed('', 'index, follow'), false);
+  assert.equal(analyticsAllowed('invalid', 'index, follow'), false);
+  assert.equal(analyticsAllowed('G-EXAMPLE123', 'index, follow'), true);
+  assert.equal(analyticsAllowed('G-EXAMPLE123', 'noindex, follow'), false);
+});
+test('form only confirms a successful provider response; errors and unconfirmed delivery are rejected', async () => {
+  const endpoint = formEndpoint('exampleid');
+  let options;
+  assert.equal(await submitEnquiry(endpoint, valid, { fetcher: async (url, opts) => { options = opts; return { ok: true, status: 200, json: async () => ({ ok: true }) }; } }), true);
+  assert.equal(options.credentials, 'omit'); assert.equal(options.headers.Accept, 'application/json');
+  for (const response of [{ ok: false, status: 400 }, { ok: false, status: 429 }, { ok: true, status: 200 }]) {
+    await assert.rejects(submitEnquiry(endpoint, valid, { fetcher: async () => ({ ...response, json: async () => ({}) }) }));
+  }
+  await assert.rejects(submitEnquiry(endpoint, valid, { fetcher: async () => { throw new TypeError('network unavailable'); } }));
+  await assert.rejects(submitEnquiry(endpoint, { ...valid, _gotcha: 'bot' }, { fetcher: () => { throw new Error('Must not request'); } }));
+  await assert.rejects(submitEnquiry('', valid));
+});
