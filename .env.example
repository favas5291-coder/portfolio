# Public build-time identifiers only. Never put private keys in VITE_* variables.
SITE_ENV=production
# Use SITE_ENV=preview for staging; pull-request builds also get noindex.
# Optional: public Formspree form ID, after activating the recipient email.
VITE_FORMSPREE_FORM_ID=
# Optional analytics. Disable Enhanced Measurement and user-provided data first.
# Visitors must opt in before the script is loaded.
VITE_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
