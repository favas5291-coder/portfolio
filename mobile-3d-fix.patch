+ if(frame)frame.remove();frame=document.createElement('iframe');frame.title='Portfolio under test';frame.width=width;frame.height=height;stage.append(frame);
+ const html=await (await fetch('/')).text();
+ const bootstrap=`<script>if(!${keep}){localStorage.removeItem('forge-view');localStorage.removeItem('forge-experience-v2');}if(${legacy})localStorage.setItem('forge-view','static');const actual=window.matchMedia.bind(window);window.matchMedia=q=>{if(q==='(prefers-reduced-motion: reduce)'||q==='(pointer: coarse)'||q==='(pointer: fine)'){const result=actual(q);Object.defineProperty(result,'matches',{value:q==='(prefers-reduced-motion: reduce)'?${reduced}:q==='(pointer: coarse)'?${coarse}:!${coarse}});return result;}return actual(q)};Object.defineProperty(navigator,'deviceMemory',{value:2,configurable:true});Object.defineProperty(navigator,'hardwareConcurrency',{value:2,configurable:true});<\/script>`;
+ frame.srcdoc=html.replace('<head>','<head>'+bootstrap);
+ for(let i=0;i<100;i++){await sleep(150);const p=frame.contentDocument?.querySelector('.portfolio');if(p&&p.dataset.sceneStatus!=='loading')return frame.contentDocument;}
+ throw Error('Timed out waiting for initialization');
+}
+const assert=(ok,message)=>{results.textContent+='\n'+(ok?'PASS ':'FAIL ')+message;if(!ok)throw Error(message)};
+document.querySelector('#run').onclick=async()=>{results.textContent='Running';try{
+ for(const [name,w,h] of [['phone',390,844],['small phone',320,780],['tablet',820,1180],['desktop',1348,900]]){
+  const doc=await load(w,h,{coarse:w<1000});const p=doc.querySelector('.portfolio');
+  assert(['ready','error'].includes(p.dataset.sceneStatus),name+': 3D attempted automatically despite 2GB / 2-core hints');
