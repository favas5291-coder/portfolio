+  assert(frame.contentWindow.scrollY>yBefore,name+': scrolling remains available');
+  for(let tries=0;tries<50&&Number(doc.querySelector('[role=progressbar]').getAttribute('aria-valuenow'))===0;tries++)await sleep(100);
+  assert(Number(doc.querySelector('[role=progressbar]').getAttribute('aria-valuenow'))>0,name+': scroll progress updates');
+  frame.width=h;frame.height=w;await sleep(350);
+  assert(doc.documentElement.scrollWidth<=h,name+': rotation-sized viewport has no overflow');
+ }
+ let doc=await load(390,844,{reduced:true,coarse:true});
+ assert(doc.querySelector('.portfolio').dataset.motion==='gentle','reduced-motion system preference selects gentle 3D');
+ doc.querySelector('.experience-options button').click();await sleep(150);
+ assert(doc.querySelector('.portfolio').dataset.motion==='full','explicit full-motion override works');
+ doc=await load(390,844,{reduced:true,coarse:true,keep:true});
+ assert(doc.querySelector('.portfolio').dataset.motion==='full','full-motion choice survives refresh');
+ doc=await load(390,844,{legacy:true,coarse:true});
+ assert(doc.querySelector('.portfolio').dataset.sceneStatus==='user-static','deliberate legacy 2D preference is preserved');
+ [...doc.querySelectorAll('button')].find(b=>b.textContent.includes('Enable 3D')).click();await sleep(1200);
+ assert(doc.querySelector('.portfolio').dataset.sceneStatus!=='user-static','explicit 3D selection exits saved 2D');
+ results.textContent+='\nDONE. Actual rendered 3D, touch gestures, context restoration on a GPU, Android Chrome and iPhone Safari still require device testing.';
+}catch(error){results.textContent+='\nERROR '+error.message;}};
+for(const [id,w,h] of [['phone',390,844],['tablet',820,1180],['desktop',1348,900]])document.querySelector('#'+id).onclick=()=>load(w,h,{coarse:w<1000});
+</script>
diff --git a/tests/experience.test.mjs b/tests/experience.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c5c5a783d60afe0c2f8f949526fb6ac7e8d8dcd4
